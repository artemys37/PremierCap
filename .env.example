# CandidBoost IA — variables d'environnement (valeurs fictives uniquement)
# Copier vers .env.local et remplacer par les valeurs réelles. Ne jamais committer .env.local.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (base, auth, stockage privé)
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key

# Fournisseur IA (côté serveur uniquement)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-example-not-a-real-key
LLM_MAX_TOKENS_PER_TASK=2000
LLM_MONTHLY_BUDGET_EUR=20

# Fournisseur email (un seul au démarrage)
EMAIL_PROVIDER=google
GOOGLE_CLIENT_ID=example-client-id
GOOGLE_CLIENT_SECRET=example-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/email/callback

# Chiffrement des jetons OAuth au repos (32 octets encodés)
TOKEN_ENCRYPTION_KEY=example-32-byte-key-change-me-000

# Worker / tâches planifiées
WORKER_SECRET=example-worker-secret
CRON_SECRET=example-cron-secret

# Observabilité (facultatif)
SENTRY_DSN=
LOG_LEVEL=info
